FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Settings for converged solutions (the released dataset used PCG for p, relaxation p 0.3 / U 0.7 and stopped at
// initial residuals U 1e-3 / p 1e-2, which stopped the 16x cases at ~170 iterations, far from steady state).
// The converged solution does not depend on these settings, the discretisation (fvSchemes) is the released one.

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;

    residualControl
    {
        p               1e-6;
        U               1e-6;
    }
}

relaxationFactors
{
    equations
    {
        U               0.9;
    }
}

