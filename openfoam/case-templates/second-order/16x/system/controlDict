FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         45000;  // cap, a case that reaches it did not converge (15000 until 12 Oct 2026)

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      2;  // keep the last two written time steps

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


