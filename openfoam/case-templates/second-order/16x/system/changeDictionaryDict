FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// gmshToFoam creates every physical surface of the .msh file as a "patch".
// changeDictionary sets the patch types by name (the released cases did the
// same with sed on fixed line numbers of constant/polyMesh/boundary).

boundary
{
    frontAndBack
    {
        type            empty;
        inGroups        1(empty);
    }

    fixedWalls
    {
        type            wall;
        inGroups        1(wall);
    }
}

